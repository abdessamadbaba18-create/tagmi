# Database
DATABASE_URL="mysql://root:@localhost:3306/tagmi_db"

# Auth
AUTH_SECRET="change-this-to-a-random-secret-in-production"

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — Apple Sign In (https://developer.apple.com/account/resources/identifiers)
# APPLE_PRIVATE_KEY = .p8 file content (PKCS#8, ES256). In .env keep it as a single line
# with literal \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TAGMI"

# Storage (future: Cloudinary, S3, etc.)
# STORAGE_PROVIDER="local"
# STORAGE_BUCKET=""
# STORAGE_KEY=""
# STORAGE_SECRET=""

# Maps (future: Google Maps, Mapbox, etc.)
# MAP_PROVIDER="leaflet"
# MAP_API_KEY=""

# AI (future: OpenAI, Anthropic, etc.)
# AI_PROVIDER="openai"
# AI_API_KEY=""

# Email (future: Resend, SendGrid, etc.)
# EMAIL_PROVIDER="resend"
# EMAIL_API_KEY=""
# EMAIL_FROM="noreply@tagmi.ma"
